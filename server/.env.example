# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a valid MongoDB connection string (e.g. mongodb://localhost:27017/jobpilot or MongoDB Atlas connection string)
MONGODB_URI=

# Telegram Bot Configuration
# Provide the token of your Telegram bot created via BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
# Provide the Telegram chat/channel identifier to pull messages from (e.g. @your_channel_name or -100123456789)
TELEGRAM_CHAT_ID=
